{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [
    "chatgpt"
  ],
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "orchestrator",
  "plugin": [
    "oh-my-opencode-slim@2.0.5"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "instructions": [
    ".opencode/oh-my-opencode-slim/project-instructions.md"
  ],
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
      "mode": "primary",
      "disable": false,
      "hidden": false
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "mode": "primary",
      "disable": false,
      "hidden": false
    },
    "general": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low"
    },
    "explorer": {
      "permission": {
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "ast_grep_replace": "deny",
        "bash": "deny",
        "task": "deny",
        "council_session": "deny",
        "cancel_task": "deny",
        "todowrite": "deny"
      }
    },
    "librarian": {
      "permission": {
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "ast_grep_replace": "deny",
        "bash": "deny",
        "task": "deny",
        "council_session": "deny",
        "cancel_task": "deny",
        "todowrite": "deny"
      }
    },
    "oracle": {
      "permission": {
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "ast_grep_replace": "deny",
        "bash": "deny",
        "task": "deny",
        "council_session": "deny",
        "cancel_task": "deny",
        "todowrite": "deny"
      }
    },
    "fixer": {
      "permission": {
        "task": "deny",
        "council_session": "deny",
        "cancel_task": "deny"
      }
    },
    "designer": {
      "permission": {
        "task": "deny",
        "council_session": "deny",
        "cancel_task": "deny"
      }
    },
    "title": {
      "model": "openai/gpt-5.6-luna",
      "variant": "none"
    },
    "summary": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "compaction": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "code-reviewer": {
      "permission": {
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "ast_grep_replace": "deny",
        "bash": "deny",
        "task": "deny",
        "council_session": "deny",
        "cancel_task": "deny",
        "todowrite": "deny"
      }
    },
    "repo-architect": {
      "permission": {
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "ast_grep_replace": "deny",
        "bash": "deny",
        "task": "deny",
        "council_session": "deny",
        "cancel_task": "deny",
        "todowrite": "deny"
      }
    },
    "test-writer": {
      "permission": {
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "ast_grep_replace": "deny",
        "bash": "deny",
        "task": "deny",
        "council_session": "deny",
        "cancel_task": "deny",
        "todowrite": "deny"
      }
    },
    "security-reviewer": {
      "permission": {
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "ast_grep_replace": "deny",
        "bash": "deny",
        "task": "deny",
        "council_session": "deny",
        "cancel_task": "deny",
        "todowrite": "deny"
      }
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 6
  },
  "permission": {
    "read": {
      "*": "allow"
    },
    "edit": {
      "*": "allow",
      ".env": "ask",
      ".env.*": "ask",
      "**/.env": "ask",
      "**/.env.*": "ask",
      ".env.example": "allow",
      "**/.env.example": "allow",

    },
    "bash": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask"
    }
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 20000
  }
}
