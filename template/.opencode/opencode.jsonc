    "bash": {
      "*": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git reset --hard": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "git branch -D *": "ask",
      "rm -rf *": "ask",
      "Remove-Item * -Recurse *": "ask",
      "Remove-Item -Recurse *": "ask",
      "rmdir /s *": "ask",
      "del /s *": "ask",
      "npm publish": "ask",
      "npm publish *": "ask",
      "pnpm publish": "ask",
      "pnpm publish *": "ask",
      "yarn npm publish *": "ask",
      "bun publish *": "ask",
      "cargo publish *": "ask",
      "dotnet nuget push *": "ask",
      "twine upload *": "ask",
      "docker push *": "ask",
      "docker system prune *": "ask",
      "kubectl *": "ask",
      "helm install *": "ask",
      "helm upgrade *": "ask",
      "terraform apply": "ask",
      "terraform apply *": "ask",
      "terraform destroy": "ask",
      "terraform destroy *": "ask",
      "pulumi up": "ask",
      "pulumi up *": "ask",
      "pulumi destroy": "ask",
      "pulumi destroy *": "ask",
      "vercel *--prod*": "ask",
      "netlify deploy *--prod*": "ask",
      "gh release create *": "ask",
      "cast send *": "ask",
      "cast publish *": "ask",
      "cast wallet *": "ask",
      "forge create *": "ask",
      "forge script *--broadcast*": "ask",
      "forge script * --broadcast *": "ask"
