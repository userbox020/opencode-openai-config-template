{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [
    "chatgpt"
  ],
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "orchestrator",
