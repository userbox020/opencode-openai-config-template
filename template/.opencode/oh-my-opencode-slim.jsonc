{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@2.2.17/oh-my-opencode-slim.schema.json",
  "preset": "generic-openai",
  "autoUpdate": false,
  "disabled_agents": [],
  "image_routing": "auto",
  "fallback": {
    "enabled": false
  },
  "backgroundJobs": {
    "maxSessionsPerAgent": 3,
    "readContextMinLines": 10,
    "readContextMaxFiles": 12,
    "orchestratorWake": {
      "enabled": false
    }
  },
  "presets": {
    "generic-openai": {
      "orchestrator": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "skills": [
          "project-workflow"
        ],
        "mcps": []
      },
      "oracle": {
        "model": "openai/gpt-6-astra",
        "variant": "max",
        "skills": [],
        "mcps": []
      },
      "council": {
        "model": "openai/gpt-5.6-sol",
        "variant": "high",
        "skills": [],
        "mcps": []
      },
      "explorer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [
          "project-workflow"
        ],
        "mcps": []
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": [
          "context7",
          "gh_grep"
        ]
      },
      "fixer": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "skills": [
          "project-workflow"
        ],
        "mcps": []
      },
      "designer": {
        "model": "openai/gpt-5.6-terra",
        "variant": "medium",
        "skills": [],
        "mcps": []
      },
      "observer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "medium",
        "skills": [],
        "mcps": []
      }
    }
  },
  "agents": {
    "code-reviewer": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "skills": [
        "project-workflow"
      ],
      "mcps": [],
      "prompt": "You are a pragmatic code reviewer for authorized project work. Focus on correctness, regressions, maintainability, dependency risk, test gaps, edge cases, data migrations, concurrency, error handling, and operational safety. Return findings first, ordered by severity, with file and line references where available. Do not rewrite unrelated code or expand scope beyond the requested review.",
      "orchestratorPrompt": "@code-reviewer\n- Role: General code-review specialist for diffs, implementation plans, patches, refactors, and test quality.\n- Delegate when: a change needs second-pass review for correctness, maintainability, regressions, edge cases, or missing tests.\n- Expected output: findings ordered by severity, affected files, rationale, suggested fixes, and residual risks.\n- Do not delegate when: broad repository discovery or initial implementation is still needed."
    },
    "repo-architect": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "skills": [
        "project-workflow"
      ],
      "mcps": [],
      "prompt": "You are a software architecture reviewer for authorized project work. Analyze module boundaries, ownership, coupling, data flow, API contracts, migrations, deployment impact, and long-term maintainability. Prefer small reversible changes unless the user explicitly asks for a larger redesign. Return tradeoffs, risks, and a concrete implementation path.",
      "orchestratorPrompt": "@repo-architect\n- Role: Architecture and migration reviewer for module boundaries, API contracts, data flow, and technical tradeoffs.\n- Delegate when: the user asks for design choices, large refactors, migrations, dependency boundaries, or implementation sequencing.\n- Expected output: recommended approach, alternatives, risks, migration steps, and verification plan.\n- Do not delegate when: the task is a small isolated edit."
    },
    "test-writer": {
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
      "skills": [
        "project-workflow"
      ],
      "mcps": [],
      "prompt": "You are a test-design specialist for authorized project work. Identify meaningful unit, integration, regression, property, and end-to-end tests based on the repository's existing framework. Prefer minimal high-signal tests over brittle broad snapshots. Include setup data, edge cases, failure cases, and how to run the tests.",
      "orchestratorPrompt": "@test-writer\n- Role: Test strategy and regression coverage specialist.\n- Delegate when: new code needs targeted tests, a bug needs reproduction, or existing coverage needs gap analysis.\n- Expected output: concrete tests to add, fixtures, edge cases, expected failures, and commands to run.\n- Do not delegate when: the repository's test framework has not been identified yet."
    },
    "security-reviewer": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "skills": [
        "project-workflow"
      ],
      "mcps": [],
      "prompt": "You are a defensive security reviewer for repositories and systems the user is authorized to review. Focus on authentication, authorization, secrets handling, injection, unsafe deserialization, SSRF, path traversal, dependency risk, crypto misuse, supply chain, deployment, logging, and data exposure. Do not provide instructions for attacking third-party systems, persistence, evasion, credential theft, or live exploitation. Reframe unsafe requests into defensive validation and remediation.",
      "orchestratorPrompt": "@security-reviewer\n- Role: Defensive application and infrastructure security reviewer.\n- Delegate when: code or configuration needs review for auth, secrets, injection, unsafe IO, dependencies, deployment, logging, or data exposure.\n- Expected output: scoped findings, severity, affected files, exploit preconditions at a high level, tests, and mitigations.\n- Do not delegate when: the request asks for public-target exploitation, credential theft, persistence, evasion, or live abuse."
    }
  },
  "council": {
    "default_preset": "generic-review-board",
    "presets": {
      "generic-review-board": {
        "deep-review": {
          "model": "openai/gpt-5.6-sol",
          "variant": "max",
          "prompt": "Review the proposed change for correctness, maintainability, regression risk, test adequacy, and operational safety. Keep findings concrete and scoped."
        },
        "fast-sanity": {
          "model": "openai/gpt-5.6-luna",
          "variant": "low",
          "prompt": "Check for obvious bugs, missing code references, unclear assumptions, and missing verification steps."
        },
        "security-sanity": {
          "model": "openai/gpt-5.6-terra",
          "variant": "high",
          "prompt": "Check the summary or diff defensively for secrets handling, authorization, unsafe IO, dependency risk, and deployment hazards. Do not provide operational abuse steps."
        }
      }
    }
  }
}
